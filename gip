#!/usr/bin/env python3
"""Zip the Git-visible contents of the current working tree."""

import argparse
import os
import stat
import subprocess
import sys
import tempfile
import zipfile
from pathlib import Path


class GipError(Exception):
    pass


def git_output(*args, cwd=None):
    try:
        return subprocess.run(
            ["git", *args],
            cwd=cwd,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).stdout
    except FileNotFoundError as error:
        raise GipError("git is not installed") from error
    except subprocess.CalledProcessError as error:
        message = os.fsdecode(error.stderr).strip() or "git command failed"
        raise GipError(message) from error


def repository_root():
    output = git_output("rev-parse", "--show-toplevel")
    return Path(os.fsdecode(output[:-1] if output.endswith(b"\n") else output))


def git_visible_paths(root):
    output = git_output(
        "-C",
        root,
        "ls-files",
        "-z",
        "--cached",
        "--others",
        "--exclude-standard",
        "--deduplicate",
    )
    for raw_path in output.split(b"\0"):
        if not raw_path:
            continue
        path = Path(os.fsdecode(raw_path))
        if path.is_absolute() or ".." in path.parts:
            raise GipError(f"git returned an unsafe path: {path}")
        yield path


def add_symlink(archive, path, archive_name, mode):
    info = zipfile.ZipInfo(archive_name)
    info.create_system = 3
    info.external_attr = (mode & 0xFFFF) << 16
    info.compress_type = zipfile.ZIP_DEFLATED
    archive.writestr(info, os.fsencode(os.readlink(path)))


def has_symlink_parent(root, relative):
    parent = root
    for part in relative.parts[:-1]:
        parent /= part
        try:
            mode = parent.lstat().st_mode
        except (FileNotFoundError, NotADirectoryError):
            return True
        if not stat.S_ISDIR(mode):
            return True
    return False


def create_archive(root, output):
    output = Path(os.path.abspath(output))
    if not output.parent.is_dir():
        raise GipError(f"output directory does not exist: {output.parent}")
    output_location = output.parent.resolve() / output.name
    paths = list(git_visible_paths(root))

    fd, temporary_name = tempfile.mkstemp(
        dir=output.parent, prefix=f".{output.name}.", suffix=".tmp"
    )
    os.close(fd)
    temporary = Path(temporary_name)
    count = 0

    try:
        with zipfile.ZipFile(
            temporary,
            "w",
            compression=zipfile.ZIP_DEFLATED,
            compresslevel=6,
            strict_timestamps=False,
        ) as archive:
            for relative in paths:
                path = root / relative
                if Path(os.path.abspath(path)) == output_location:
                    continue
                if has_symlink_parent(root, relative):
                    continue
                try:
                    mode = path.lstat().st_mode
                except FileNotFoundError:
                    continue

                archive_name = relative.as_posix()
                if stat.S_ISLNK(mode):
                    add_symlink(archive, path, archive_name, mode)
                elif stat.S_ISREG(mode):
                    archive.write(path, archive_name)
                elif stat.S_ISDIR(mode):
                    # ponytail: gitlinks stay boundaries; recurse if submodule contents are needed.
                    continue
                else:
                    raise GipError(f"unsupported file type: {relative}")
                count += 1

        os.replace(temporary, output)
    except BaseException:
        temporary.unlink(missing_ok=True)
        raise

    return count


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="ZIP tracked and non-ignored untracked files from the current Git repository."
    )
    parser.add_argument("output", nargs="?", type=Path, help="output path (default: <repo>.zip)")
    args = parser.parse_args(argv)

    try:
        root = repository_root()
        output = args.output or Path.cwd() / f"{root.name}.zip"
        count = create_archive(root, output)
    except (GipError, OSError, zipfile.BadZipFile) as error:
        print(f"gip: {error}", file=sys.stderr)
        return 1

    print(f"Created {Path(os.path.abspath(output))} ({count} files)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
